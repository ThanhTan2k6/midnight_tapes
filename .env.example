# ============================================================================
# TIỆM BĂNG NỬA ĐÊM (MIDNIGHT TAPES) — ENVIRONMENT VARIABLES
# Copy file này thành .env.local và điền thông tin thật của bạn
# ============================================================================

# 1. Security & Hashing (Zero-Login Session + IP Hash)
# Tạo chuỗi ngẫu nhiên dài >= 32 ký tự (vd: openssl rand -hex 32)
SERVER_HASH_SALT=change_me_to_a_long_random_secret_string
IP_DAILY_SALT=change_me_to_another_random_secret_string

# 2. Supabase (PostgreSQL + pgvector + pg_cron)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 3. Cloudflare R2 (Zero-egress Audio Storage)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=midnight-tapes-audio
R2_PUBLIC_CDN_URL=https://cdn.yourdomain.com

# 4. Upstash Redis (Rate Limiting)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# 5. AI Moderation & Psych-Support RAG
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key-optional-for-whisper
